# =====================================================================
# GuardianLink Lite – Server Environment Variables
# =====================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =====================================================================

# JWT secret for legacy REST API (still used as fallback)
JWT_SECRET=change_this_to_a_long_random_secret_before_running

# Port the server listens on (default 3001)
PORT=3001

# Node environment
NODE_ENV=development

# ─── Firebase Admin SDK ───────────────────────────────────────────────────────
# Option A: Path to downloaded service account JSON file
# Download from: Firebase Console → Project Settings → Service Accounts → Generate new private key
# Save as: server/firebase-service-account.json  (already in .gitignore)
# (no env var needed if the file exists at the default path)

# Option B: JSON string for deployment (e.g. Railway, Render, Fly.io)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"guardian-link-6de8a",...}

# ─── Referral Service (WireMock stub) ──────────────────────────────────────────
# URL of the WireMock mock referral endpoint. Run `node wiremock/mock-server.js`
# REFERRAL_ENDPOINT_URL=http://localhost:8080/referral

# Request timeout for referral HTTP calls (milliseconds)
# REFERRAL_TIMEOUT_MS=5000

# ─── PII Tokenizer ─────────────────────────────────────────────────────────────
# Hex-encoded 32-byte key for AES-256-CBC token map encryption.
# If unset, a random key is generated per process (data lost on restart).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# TOKENIZER_KEY=your_hex_key_here
