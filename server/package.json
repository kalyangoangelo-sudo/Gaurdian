{
  "name": "guardianlink-lite-server",
  "version": "1.0.0",
  "description": "GuardianLink Lite backend – Express + Socket.IO + JWT",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "npx nodemon src/server.js",
    "test": "node node_modules/jest/bin/jest.js --forceExit"
  },
  "dependencies": {
    "bcryptjs": "2.4.3",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "^4.22.3",
    "express-rate-limit": "7.3.1",
    "express-validator": "^7.2.1",
    "firebase-admin": "^12.3.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "9.0.2",
    "multer": "^1.4.5-lts.1",
    "socket.io": "^4.8.4",
    "sql.js": "^1.12.0",
    "uuid": "9.0.1"
  },
  "devDependencies": {
    "jest": "29.7.0",
    "nodemon": "3.1.4",
    "supertest": "7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ],
    "transform": {},
    "testTimeout": 30000
  }
}
